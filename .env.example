# Cloud-only. Docker Compose uses fixed fictional local-demo credentials.
JDBC_URL=jdbc:postgresql://localhost:5432/claimpulse
JDBC_USER=claimpulse
JDBC_PASSWORD=replace-me
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC=claim-events
CHECKPOINT_DIR=/durable/checkpoints
CLAIMPULSE_INGEST_TOKEN=replace-with-long-random-value
CLAIMPULSE_DEMO_ENABLED=false
